#!/bin/bash

usage() {
    echo "Usage: $0 -e <environment> [-q] [-n]"
    echo "  -e <environment>  Specify the environment to stow (i3 or hyprland)"
    echo "  -q                Disable verbose output"
    echo "  -n                Perform a dry run without applying changes"
    echo "  -i                Install missing packages instead of just checking"
    exit 1
}

# Parse arguments
while getopts "e:q:n" opt; do
    case $opt in
    e)
        ENVIRONMENT=$OPTARG
        ;;
    q)
        QUIET=true
        ;;
    n)
        DRY_RUN=true
        ;;
    i)
        INSTALL_MISSING=true
        ;;
    *)
        usage
        ;;
    esac
done

if [[ -z $ENVIRONMENT ]]; then
    usage
fi

case $ENVIRONMENT in
i3)
    STOW_FOLDERS="ohmyposh,zsh,rofi,tmux,nvim,i3,dunst,fastfetch,bin,alacritty,autokey"
    ENV_META_DIR="$DOTFILES/i3/.meta"
    ;;
hyprland)
    STOW_FOLDERS="ohmyposh,zsh,rofi,tmux,nvim,hyperland,dunst,bin,alacritty,fastfetch,kvantum,archlinux,arch-scripts,wiremix"
    ENV_META_DIR="$DOTFILES/hyprland/.meta"
    ;;
server)
    STOW_FOLDERS="ohmyposh,zsh,rofi,tmux,nvim,bin"
    ENV_META_DIR="$DOTFILES/server/.meta"
    ;;
*)
    echo "Invalid environment: $ENVIRONMENT"
    usage
    ;;
esac

# Set DOTFILES if not already set
if [[ -z $DOTFILES ]]; then
    DOTFILES=$HOME/.dotfiles
fi

check_stow_installed() {
    if ! command -v stow &>/dev/null; then
        echo "Error: 'stow' could not be found. Please install it first."
        exit 1
    fi
}

validate_folders() {
    IFS=',' read -ra FOLDERS <<<"$STOW_FOLDERS"
    for folder in "${FOLDERS[@]}"; do
        if [[ ! -d "$DOTFILES/$folder" ]]; then
            echo "Error: Folder $folder does not exist in $DOTFILES"
            exit 1
        fi
    done
}

detect_package_manager() {
    if command -v pacman &>/dev/null; then
        echo "pacman"
    elif command -v dnf &>/dev/null; then
        echo "dnf"
    elif command -v apt &>/dev/null; then
        echo "apt"
    else
        echo "Unsupported package manager."
        exit 1
    fi
}

is_package_installed() {
    local pkg_manager="$1"
    local pkg="$2"

    case "$pkg_manager" in
    pacman)
        pacman -Q "$pkg" &>/dev/null && return 0
        ;;
    dnf)
        rpm -q "$pkg" &>/dev/null && return 0
        ;;
    apt)
        dpkg -l | grep -q "^ii  $pkg " && return 0
        ;;
    esac

    # Check if the package provides a command
    if command -v "$pkg" &>/dev/null; then
        return 0
    fi

    return 1
}

read_packages_from_meta() {
    packages=()
    if [[ -f "$ENV_META_DIR/packages.txt" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            # Remove quotes and ignore empty lines
            pkg=$(echo "$line" | sed 's/"//g' | xargs)
            [[ -n "$pkg" ]] && packages+=("$pkg")
        done <"$ENV_META_DIR/packages.txt"
    fi
}

check_packages() {
    local pkg_manager="$1"
    local missing=()

    for pkg in "${packages[@]}"; do
        if ! is_package_installed "$pkg_manager" "$pkg"; then
            echo "Package '$pkg' is missing."
            missing+=("$pkg")
        fi
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "Some packages are missing."
        return 1
    else
        echo "All packages are installed."
        return 0
    fi
}

install_missing_packages() {
    local pkg_manager="$1"

    for pkg in "${packages[@]}"; do
        if ! is_package_installed "$pkg_manager" "$pkg"; then
            echo "Installing missing package: $pkg"
            case "$pkg_manager" in
            pacman)
                sudo pacman -S --noconfirm "$pkg"
                ;;
            dnf)
                sudo dnf install -y "$pkg"
                ;;
            apt)
                sudo apt install -y "$pkg"
                ;;
            esac
        fi
    done
}

stow_folders() {
    pushd "$DOTFILES" >/dev/null || exit 1

    IFS=',' read -ra FOLDERS <<<"$STOW_FOLDERS"

    for folder in "${FOLDERS[@]}"; do
        [[ "$QUIET" != true ]] && echo "Stowing folder $folder..."

        if [[ "$DRY_RUN" == true ]]; then
            echo "Dry run: stow -D $folder"
            echo "Dry run: stow $folder"
        else
            if [[ "$QUIET" == true ]]; then
                stow -D "$folder" >/dev/null
                stow "$folder" >/dev/null
            else
                stow -D "$folder"
                stow "$folder"
            fi
        fi
    done

    popd >/dev/null
}

check_stow_installed
validate_folders

pkg_manager=$(detect_package_manager)
read_packages_from_meta

if  [[ ${#packages[@]} -gt 0 ]]; then
    if [[ "$INSTALL_MISSING" == true ]]; then
        install_missing_packages "$pkg_manager"
    else
        if ! check_packages "$pkg_manager"; then
            echo "Missing packages detected. Use -i to install them automatically."
            exit 1
        fi
    fi
else
    echo "No packages to check in $ENV_META_DIR/packages.txt"
fi

stow_folders
