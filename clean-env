#!/bin/bash

# Ensure DOTFILES is set
if [[ -z $DOTFILES ]]; then
    echo "DOTFILES variable is not set. Please set it to your dotfiles directory."
    exit 1
fi

# Ensure STOW_FOLDERS is set
if [[ -z $STOW_FOLDERS ]]; then
    echo "STOW_FOLDERS variable is not set. Please set it to the folders you want to clean."
    exit 1
fi

# Change to the DOTFILES directory
pushd $DOTFILES || { echo "Failed to change directory to $DOTFILES"; exit 1; }

# Unstow each folder in STOW_FOLDERS
IFS=',' read -r -a folder_array <<< "$STOW_FOLDERS"
for folder in "${folder_array[@]}"; do
    echo "Removing $folder"
    stow -D $folder
done

# Return to the original directory
popd
