
# Set personal aliases, overriding those provided by oh-my-zsh libs,
# plugins, and themes. Aliases can be placed here, though oh-my-zsh
# users are encouraged to define aliases within the ZSH_CUSTOM folder.
# For a full list of active aliases, run `alias`.
#
# Example aliases
alias zshconf="nvim ~/.zsh_profile"
alias asus="ssh -p 717 192.168.0.17"
alias work="cd ~/workspace"
alias cod="codium"
alias py="python3"
alias python="python3"
alias czsh="source ~/.zshrc"
alias glow="git flow"
alias getch="git fetch --prune"
alias gull="git pull"
alias gush="git push"
alias neofetch='fastfetch'
alias fetch='fastfetch'
alias vim="nvim"

addToPathFront() {
    if [[ ":$PATH:" != *":$1:"* ]]; then
        export PATH="$1:$PATH"
    fi
}

export CPP_LIBS="/usr/include"
export CPP_LIBS2="/usr/local/include"
export JAVA_HOME="/usr/lib/jvm/jdk-17.0.2"
export GO_HOME="/usr/local/go"
export TERMINAL="/usr/local/bin/alacritty"
export ANDROID_HOME="$HOME/Android/Sdk"

# All PATHS that might be needed
addToPathFront $HOME/.local/bin
addToPathFront $JAVA_HOME/bin
addToPathFront $GO_HOME/bin
addToPathFront $CPP_LIBS
addToPathFront $CPP_LIBS2
addToPathFront $ANDROID_HOME/Sdk

# bind to start tmux fzf
bindkey -s ^f "tmux-sessionizer\n"

# To make github private key permanent
if [ -z "$SSH_AUTH_SOCK" ]; then
    eval "$(ssh-agent -s)" > /dev/null 2>&1
    ssh-add ~/.ssh/github > /dev/null 2>&1
    ssh-add ~/.ssh/asusV2 > /dev/null 2>&1
    ssh-add ~/.ssh/id_rsa_remarkable > /dev/null 2>&1
fi

eval "$(oh-my-posh init zsh --config $HOME/.config/ohmyposh/theme.toml)"
