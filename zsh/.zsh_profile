# Set personal aliases, overriding those provided by oh-my-zsh libs,
# plugins, and themes. Aliases can be placed here, though oh-my-zsh
# users are encouraged to define aliases within the ZSH_CUSTOM folder.
# For a full list of active aliases, run `alias`.
#
# Example aliases
alias zshconf="nvim ~/.zsh_profile"
alias asus="ssh -p 717 192.168.0.17"
alias work="cd ~/workspace"
alias cod="codium"
alias py="python3"
alias python="python3"
alias czsh="source ~/.zshrc"
alias glow="git flow"

addToPathFront() {
    if [[ ":$PATH:" != *":$1:"* ]]; then
        export PATH="$1:$PATH"
    fi
}

export JAVA_HOME="/usr/lib/jvm/jdk-21-oracle-x64"
export NVIM_HOME="$HOME/workspace/neovim"
export DOTNET_ROOT=$HOME/.dotnet

# All PATHS that might be needed
addToPathFront $HOME/.local/bin
addToPathFront $JAVA_HOME/bin
addToPathFront $NVIM_HOME/bin
addToPathFront $DOTNET_ROOT
addToPathFront $DOTNET_ROOT/tools

# bind to start tmux fzf
bindkey -s ^f "tmux-sessionizer\n"

# To make github private key permanent
if [ -z "$SSH_AUTH_SOCK" ]; then
    eval "$(ssh-agent -s)"
    ssh-add ~/.ssh/github
fi
